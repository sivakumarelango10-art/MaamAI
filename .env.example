# ==============================================================================
# MaamAI Consolidated Environment Configuration (.env.example)
# ==============================================================================
# This is the single canonical environment template for the entire MaamAI project.
# Copy this file to '.env' at the project root for local development:
#     copy .env.example .env
#
# NEVER COMMIT REAL PRODUCTION SECRETS, PASSWORDS, OR PRIVATE KEYS TO GIT.
# In production (Vercel), configure these variables in:
#     Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# 'development' enables local SQLite auto-migration, demo accounts, and staff switcher.
# 'production' disables demo accounts, disables staff switcher, enforces strict secrets.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. BACKEND AUTHENTICATION (JWT) - PRIVATE / SERVER-SIDE ONLY
# ------------------------------------------------------------------------------
# In production, must be a high-entropy secret with at least 32 characters.
# Generate production key: openssl rand -hex 32
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_maamai_academic_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ------------------------------------------------------------------------------
# 3. OAUTH TOKEN ENCRYPTION AT REST - PRIVATE / SERVER-SIDE ONLY
# ------------------------------------------------------------------------------
# Authenticated Fernet (AES-128-CBC + HMAC-SHA256) encryption for sensitive tokens.
# Must be 32 URL-safe base64-encoded bytes.
# Generate a new Fernet key:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=your_generated_fernet_key_base64_here=

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION - PRIVATE / SERVER-SIDE ONLY
# ------------------------------------------------------------------------------
# Local Development: SQLite file (resolved to backend/maamai.db)
DATABASE_URL=sqlite:///./maamai.db

# Production Supabase PostgreSQL (Connect via Transaction Pooler on port 6543):
# Replace [YOUR-PASSWORD] with your actual Supabase database password:
# DATABASE_URL=postgresql://postgres.inrrhqnkvwublklehivy:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Session Pooler (Used for Alembic DDL schema migrations on port 5432):
# DIRECT_URL=postgresql://postgres.inrrhqnkvwublklehivy:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 5. CORS ALLOWED ORIGINS - PRIVATE / SERVER-SIDE ONLY
# ------------------------------------------------------------------------------
# JSON array of origins permitted to call the backend API
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://maamai.vercel.app"]

# ------------------------------------------------------------------------------
# 6. GOOGLE WORKSPACE & OAUTH CONFIGURATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Strict server-side Google account allowlist (JSON array)
ALLOWED_GOOGLE_EMAILS=["sivakumarelango10@gmail.com","avishka.s@kalvium.com"]

# Google Cloud Platform OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://maamai.vercel.app/api/auth/google/callback
ENABLE_GMAIL_SYNC=true
ENABLE_GCAL_SYNC=true

# ------------------------------------------------------------------------------
# 7. AI INFERENCE PROVIDER (STRICT ₹0 BUDGET)
# ------------------------------------------------------------------------------
# Options: gemini_free | ollama_local | deterministic
AI_PROVIDER=gemini_free

# Google Gemini Free Tier API Key (Obtain from https://aistudio.google.com/):
GEMINI_API_KEY=

# Local Ollama URL (100% private on laptop):
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT CONFIGURATION (VITE) - PUBLIC / BROWSER-SAFE ONLY
# ------------------------------------------------------------------------------
# Only variables prefixed with 'VITE_' are exposed to client-side React code.
# In unified Vercel deployment, leave relative '/api' to route to backend service.
VITE_API_BASE_URL=/api
VITE_API_URL=/api
VITE_APP_ENV=development

# Supabase Public Browser Configuration (Project: inrrhqnkvwublklehivy)
VITE_SUPABASE_URL=https://inrrhqnkvwublklehivy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kw-KyJZvPfraCnunbhRJvw_MqgN8vUv
VITE_SUPABASE_ANON_KEY=sb_publishable_kw-KyJZvPfraCnunbhRJvw_MqgN8vUv

# ------------------------------------------------------------------------------
# 9. BACKEND SUPABASE SERVICE CONFIGURATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://inrrhqnkvwublklehivy.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_kw-KyJZvPfraCnunbhRJvw_MqgN8vUv
SUPABASE_JWKS_URL=https://inrrhqnkvwublklehivy.supabase.co/auth/v1/.well-known/jwks.json
# Optional Supabase Secret Key (Server-side ONLY; NEVER expose to frontend or git):
# SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
