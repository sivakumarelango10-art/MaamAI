# ==============================================================================
# MaamAI Phase 2 Environment Configuration (.env.example)
# NEVER COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# Application Environment: 'development' | 'production'
# In production: Demo seeding, staff switcher, and sensitive traces are automatically disabled.
ENVIRONMENT=development

# Backend JWT Configuration (Replace with a high-entropy 64-char hex string in production: openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_for_production_32_bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OAuth Token Encryption Key (Fernet 32-byte URL-safe base64 key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=your_fernet_url_safe_base64_encryption_key_here=

# Database Configuration
# Local Development: SQLite (auto-created in workspace)
DATABASE_URL=sqlite:///./maamai.db

# Production Supabase PostgreSQL (Connect via Supavisor Transaction Pooler on port 6543)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Session Pooler (Used for Alembic schema migrations on port 5432)
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# CORS Allowed Origins (JSON array of allowed frontend URLs)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://your-app.vercel.app"]

# Multi-User Google OAuth Configuration (Google Cloud Free Tier)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/oauth/google/callback

# AI Provider Configuration (Strict ₹0 Budget)
# Options: gemini_free | ollama_local | deterministic
AI_PROVIDER=gemini_free

# Google Gemini Free Tier (gemini-1.5-flash: 15 RPM, 1M TPM, 1,500 RPD @ ₹0)
# Obtain free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_free_tier_gemini_api_key_without_billing

# Ollama Local (100% Free & Private on Laptop)
OLLAMA_BASE_URL=http://localhost:11434

# Frontend Configuration (Vite)
# When deploying unified on Vercel, leave empty to use relative '/api'
VITE_API_BASE_URL=/api

# Optional: Supabase Public Credentials (For optional direct client extensions)
# VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
