# Environment files and credentials (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# SQLite Databases & Local Storage
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/maamai.db

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Node.js & Frontend Build Artifacts
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Operating System
.vscode/
.idea/
*.sublime-project
